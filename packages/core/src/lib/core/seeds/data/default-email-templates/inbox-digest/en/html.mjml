<mjml>
	<mj-body background-color="#fff">
		<mj-section>
			<mj-column>
				<mj-divider border-color="#1B005D" border-width="1px"></mj-divider>
				<mj-text font-size="20px" font-family="helvetica">Your daily digest</mj-text>
				<mj-text font-size="16px" font-family="helvetica">
					<p>{{count}} new {{#if plural}}entries{{else}}entry{{/if}} since your last digest.</p>
				</mj-text>
				<mj-text font-size="16px" font-family="helvetica">
					{{#each items}}
					<p>
						<span style="color: #6c757d">{{this.kindLabel}}</span><br />
						<a href="{{this.link}}" style="color: #1B005D">{{this.title}}</a>
						{{#if this.body}}<br /><span style="color: #6c757d">{{this.body}}</span>{{/if}}
					</p>
					{{/each}}
					{{#if more}}
					<p>… and {{more}} more in your Inbox.</p>
					{{/if}}
				</mj-text>
				<mj-button href="{{inboxLink}}" background-color="#1B005D" font-family="helvetica">Open your Inbox</mj-button>
				<mj-divider border-color="#1B005D" border-width="1px"></mj-divider>
				<mj-text align="center" font-size="12px" font-family="helvetica" color="#6c757d">
					You receive this digest because your notification settings ask for it.
					<a href="{{settingsLink}}" style="color: #598bff">Change them</a>.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
