<mjml lang="bg">
	<mj-head>
		<mj-title>Поканени сте да се присъедините към {{organizationName}}</mj-title>
		<mj-preview>Приемете поканата, за да започнете работа в {{appName}}.</mj-preview>
		<mj-attributes>
			<mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
			<mj-text align="left" color="#3F3F46" font-size="15px" line-height="24px" padding="0 10px 16px" />
			<mj-button align="left" background-color="#4F46E5" border-radius="8px" color="#FFFFFF" font-size="15px" font-weight="600" inner-padding="12px 24px" line-height="20px" padding="8px 10px 24px" />
			<mj-divider border-color="#E4E4E7" border-width="1px" padding="8px 10px 24px" />
			<mj-class name="brand" color="#18181B" font-size="18px" font-weight="600" line-height="24px" padding="6px 10px 28px" />
			<mj-class name="eyebrow" color="#71717A" font-size="13px" font-weight="600" line-height="20px" padding="0 10px 4px" />
			<mj-class name="heading" color="#18181B" font-size="22px" font-weight="600" line-height="30px" padding="0 10px 12px" />
			<mj-class name="note" color="#71717A" font-size="13px" line-height="20px" />
			<mj-class name="footer" align="center" color="#66666F" font-size="12px" line-height="18px" padding="0" />
			<mj-class name="danger" background-color="#DC2626" />
			<mj-class name="secondary" background-color="#FFFFFF" border="1px solid #D4D4D8" color="#18181B" inner-padding="11px 24px" />
		</mj-attributes>
		<mj-style>
			@media only screen and (max-width: 479px) {
				.email-card > table > tbody > tr > td { padding: 22px 12px 14px !important; }
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#F4F4F5" width="600px">
		<mj-section padding="32px 16px 0">
			<mj-column css-class="email-card" background-color="#FFFFFF" border="1px solid #E4E4E7" border-radius="12px" padding="30px 30px 20px">
				<mj-raw>{{#if appLogo}}</mj-raw>
				<mj-text font-size="0" line-height="0" padding="0 0 22px">
					<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate">
						<tr>
							<td bgcolor="#FFFFFF" style="background-color: #FFFFFF; background-image: linear-gradient(#FFFFFF, #FFFFFF); border-radius: 8px; padding: 6px 10px">
								<a href="{{appLink}}" target="_blank" style="text-decoration: none"><img src="{{appLogo}}" alt="{{appName}}" height="24" style="display: block; height: 24px; width: auto; border: 0; outline: none; color: #18181B; font-size: 18px; font-weight: 600; line-height: 24px; text-decoration: none" /></a>
							</td>
						</tr>
					</table>
				</mj-text>
				<mj-raw>{{else}}</mj-raw>
				<mj-text mj-class="brand">{{appName}}</mj-text>
				<mj-raw>{{/if}}</mj-raw>
				<mj-text mj-class="heading">Поканени сте да се присъедините към {{organizationName}}</mj-text>
				<mj-text>
					Поканени сте да се присъедините към <strong dir="auto" style="color: #18181B; font-weight: 600">{{organizationName}}</strong> в {{appName}}{{#if role}} като <strong dir="auto" style="color: #18181B; font-weight: 600">{{role}}</strong>{{/if}}.
				</mj-text>
				<mj-button href="{{generatedUrl}}" target="_blank">Приемане на поканата</mj-button>
				<mj-text mj-class="note">
					Ако имате някакви въпроси, можете да се свържете с нас, като отговорите на този имейл. Ако не сте очаквали тази покана, можете да пренебрегнете този имейл.
				</mj-text>
				<mj-divider />
				<mj-text mj-class="note" padding="0 10px 12px">
					С уважение,<br />
					<span style="color: #18181B; font-weight: 600">Екипът на {{organizationName}}</span>
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section padding="20px 16px 40px">
			<mj-column>
				<mj-text mj-class="footer">
					<a href="{{appLink}}" target="_blank" style="color: #66666F; text-decoration: underline">{{appName}}</a>
					{{#if companyName}}<br />&copy; <a href="{{companyLink}}" target="_blank" style="color: #66666F; text-decoration: underline">{{companyName}}</a>. Всички права запазени.{{/if}}
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
