{
	"name": "core",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/core/src",
	"projectType": "library",
	"release": {
		"version": {
			"currentVersionResolver": "git-tag",
			"preserveLocalDependencyProtocols": false,
			"manifestRootsToUpdate": ["dist/{projectRoot}"]
		}
	},
	"tags": ["type:core"],
	"implicitDependencies": ["auth", "common", "config", "constants", "contracts", "plugin", "scheduler", "utils"],
	"targets": {
		"build": {
			"executor": "@nx/js:tsc",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/packages/core",
				"tsConfig": "packages/core/tsconfig.lib.json",
				"packageJson": "packages/core/package.json",
				"main": "packages/core/src/index.ts",
				"assets": [
					"packages/core/*.md",
					{
						"input": "packages/core/src",
						"output": "src",
						"glob": "**/*.{gql,hbs,mjml,csv,json}"
					}
				]
			},
			"dependsOn": ["^build"]
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "nodemon --restartable rs --ignore .git --ignore node_modules/ --ignore dist/ --ignore coverage/ --ignore src/**/*.spec.ts --watch packages/core/src --exec \"ts-node -r tsconfig-paths/register packages/core/src/lib/main.ts\" --env NODE_ENV=development --ext ts",
				"cwd": "."
			}
		},
		"nx-release-publish": {
			"options": {
				"packageRoot": "dist/{projectRoot}"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test-postgres-migrations": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node --test .scripts/tenant-stripe-customer.postgres.test.cjs"
			}
		},
		"graphql-inputs": {
			"executor": "nx:run-commands",
			"cache": false,
			"outputs": ["{workspaceRoot}/packages/core/src/lib/graphql/schema"],
			"options": {
				"command": "node -r ts-node/register -r tsconfig-paths/register packages/core/src/lib/graphql/codegen/filter-inputs.ts",
				"cwd": "."
			}
		},
		"graphql-snapshot": {
			"executor": "nx:run-commands",
			"cache": false,
			"outputs": ["{workspaceRoot}/packages/core/src/lib/graphql/schema/schema.graphql"],
			"options": {
				"command": "node -r ts-node/register -r tsconfig-paths/register packages/core/src/lib/graphql/schema-snapshot.ts --write",
				"cwd": "."
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "packages/core/jest.config.ts"
			}
		},
		"test-migration-smoke": {
			"executor": "@nx/jest:jest",
			"options": {
				"jestConfig": "packages/core/jest.config.ts",
				"testFile": "src/lib/database/migration-smoke\\.spec\\.ts$",
				"testPathIgnorePatterns": ["/node_modules/"],
				"passWithNoTests": false
			}
		}
	}
}
