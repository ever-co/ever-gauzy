{
	"name": "plugin-realtime",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/plugins/realtime/src",
	"projectType": "library",
	"release": {
		"version": {
			"manifestRootsToUpdate": ["dist/{projectRoot}"],
			"currentVersionResolver": "git-tag",
			"fallbackCurrentVersionResolver": "disk"
		}
	},
	"tags": ["type:plugin"],
	"implicitDependencies": ["common", "config", "contracts", "core", "plugin", "utils", "plugin-docs"],
	"targets": {
		"build": {
			"executor": "@nx/js:tsc",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/packages/plugins/realtime",
				"tsConfig": "packages/plugins/realtime/tsconfig.lib.json",
				"packageJson": "packages/plugins/realtime/package.json",
				"main": "packages/plugins/realtime/src/index.ts",
				"assets": ["packages/plugins/realtime/*.md"]
			},
			"dependsOn": ["^build"]
		},
		"nx-release-publish": {
			"options": {
				"packageRoot": "dist/{projectRoot}"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "packages/plugins/realtime/jest.config.ts"
			}
		},
		"test-postgres": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c packages/plugins/realtime/jest.postgres.config.ts --runInBand"
			}
		}
	}
}
