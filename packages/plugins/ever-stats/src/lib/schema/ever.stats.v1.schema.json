  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer minor units (cents) of the currency named by the key; a period total, never a per-record value."
    },
    "amount_minor_signed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Integer minor units; may be negative for refund-heavy periods."
    },
    "currency_map": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$",
        "maxLength": 3
      },
      "maxProperties": 20,
      "additionalProperties": {
        "$ref": "#/$defs/amount_minor"
      }
    },
    "currency_map_signed": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$",
        "maxLength": 3
      },
      "maxProperties": 20,
      "additionalProperties": {
        "$ref": "#/$defs/amount_minor_signed"
      }
    },
