{
	"name": "@gauzy/plugin-ever-stats",
	"version": "0.1.0",
	"description": "Ever Gauzy Platform plugin that sends one anonymous usage statistics report a day (counts and monthly totals only), signed, with a published schema; on by default and switched off with EVER_STATS_ENABLED=false or in Settings",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-gauzy",
		"directory": "packages/plugins/ever-stats"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-gauzy/issues"
	},
	"homepage": "https://ever.co",
	"license": "AGPL-3.0",
	"private": true,
	"type": "commonjs",
	"main": "./src/index.js",
	"types": "./src/index.d.ts",
	"scripts": {
		"lib:build": "yarn nx build plugin-ever-stats",
		"lib:build:prod": "yarn nx build plugin-ever-stats",
		"lib:watch": "yarn nx build plugin-ever-stats --watch"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.1.26",
		"@nestjs/core": "^11.1.26"
	},
	"dependencies": {
		"@ever-co/connect-contracts": "1.0.0-rc.2",
		"@ever-co/connect-sdk": "1.0.0-rc.2",
		"@gauzy/common": "^0.1.0",
		"@gauzy/config": "^0.1.0",
		"@gauzy/constants": "^0.1.0",
		"@gauzy/contracts": "^0.1.0",
		"@gauzy/core": "^0.1.0",
		"@gauzy/plugin": "^0.1.0",
		"@gauzy/plugin-ever-instance": "^0.1.0",
		"@mikro-orm/core": "^6.6.14",
		"@nestjs/swagger": "^11.4.4",
		"nestjs-cls": "^6.2.0",
		"tslib": "^2.6.2",
		"typeorm": "^1.0.0"
	},
	"devDependencies": {
		"@ever-co/connect-tools": "1.0.0-rc.2",
