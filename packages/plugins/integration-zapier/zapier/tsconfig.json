{
	"compilerOptions": {
		"outDir": "lib",
		"rootDir": "src",
		"target": "es2019",
		"module": "commonjs",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"strict": true,
		"declaration": true,
		"sourceMap": true,
		"incremental": true,
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": false,
		"types": ["*"],
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "**/*.test.ts", "lib"]
}
