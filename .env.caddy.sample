# Settings for docker-compose.caddy.yml (Ever Gauzy behind Caddy, automatic HTTPS).
#
#   cp .env.caddy.sample .env.caddy      # .env.caddy is git-ignored: never commit it
#   docker compose -f docker-compose.caddy.yml --env-file .env.caddy up -d
#
# Every empty value below is required: Docker Compose refuses to start the stack while one is missing. Generate the
# database password and the secrets with e.g. `openssl rand -hex 64`, and the DEMO_*_PASSWORD values with e.g.
# `openssl rand -hex 24` (the sign-in form takes at most 50 characters). Other API / web app settings live in
# .env.compose.

# The domain Gauzy is served on. `localhost` runs locally with Caddy's own certificate authority; a public domain
# (its DNS pointing at this host, ports 80 and 443 open) gets a Let's Encrypt / ZeroSSL certificate automatically.
GAUZY_DOMAIN=localhost

# The URL browsers use. Defaults to https://$GAUZY_DOMAIN; set it only when you publish Caddy on other host ports,
# e.g. GAUZY_HTTPS_PORT=8443 with GAUZY_PUBLIC_URL=https://localhost:8443.
# GAUZY_PUBLIC_URL=
# GAUZY_HTTP_PORT=80
# GAUZY_HTTPS_PORT=443

# Image tag of ghcr.io/ever-co/gauzy-api, gauzy-webapp and gauzy-worker (default: latest).
# GAUZY_IMAGE_TAG=latest

# PostgreSQL password (the database is reachable only inside this stack). Set it before the first start: the
# database volume keeps the password it was created with.
DB_PASS=
# DB_NAME=gauzy
# DB_USER=postgres

# Authentication and session secrets: the API refuses to start without strong, unique values.
JWT_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_VERIFICATION_TOKEN_SECRET=
EXPRESS_SESSION_SECRET=

# Passwords of the three accounts created on the first start against an empty database (Super Admin admin@ever.co,
# Admin local.admin@ever.co, Employee employee@ever.co, unless you set the *_EMAIL values).
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
# DEMO_SUPER_ADMIN_EMAIL=
# DEMO_ADMIN_EMAIL=
# DEMO_EMPLOYEE_EMAIL=
