{
	"product": "gauzy",
	"compose": ["compose.egress-audit.yml"],
	"project": "ever-audit-gauzy",
	"subnet": "10.231.7.0/24",
	"api_service": "api",
	"process_services": ["api"],
	"services": ["api", "webapp"],
	"health_url": "http://api:3000/api/health",
	"health_timeout_s": 1200,
	"module_routes": ["/api/ever-stats/status", "/api/ever-stats/last", "/api/ever-stats/state"],
	"adapter": "adapter.mjs",
	"wait_s": 120,
	"allowed_external_hosts": ["fonts.googleapis.com", "maps.googleapis.com"],
	"web_service": "webapp",
	"web_static": true,
	"web_url": "http://webapp:4200/#",
	"ui_routes": "ui-routes.json",
	"route_params": "route-params.json",
	"ui_baseline": "ui-baseline.json",
	"idle_pages": ["/pages/settings/usage-statistics", "/pages/integrations", "/pages/integrations/ever-connect"],
	"ui_page_timeout_s": 90,
	"ui_skip_routes": [{ "path": "/auth/logout", "reason": "signs the walk out; the sign-in page itself is opened by the sign-in" }],
	"ui_expected_requests": { "positive_stats": ["GET /api/ever-stats/status"] },
	"modes": {
		"off_env_file": {
			"description": "Statistics switched off ONLY in the API's .env.local file (in the API's working directory), nothing about them in the container environment: the module is not loaded, no call, no Ever host looked up, every module route 404.",
			"env": { "EVER_STATS_SEND_INTERVAL_S": "5" },
			"mock": false,
			"module_routes": "404",
			"allowed_rows": [],
			"required_rows": []
		}
	}
}
